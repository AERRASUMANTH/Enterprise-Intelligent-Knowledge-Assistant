# Copy this file to .env and fill in real values.
# Never commit your .env file.

# ---- App ----
APP_NAME="Enterprise Knowledge Assistant"
ENVIRONMENT=development
DEBUG=true
# Frontend URLs allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- Gemini LLM ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=enterprise_knowledge

# ---- Chunking (characters) ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=10

# ---- Retrieval ----
DEFAULT_TOP_K=3
MAX_TOP_K=20

# ---- Microsoft Graph API (Outlook / Teams / SharePoint) ----
# Not required to run the app. Leave empty until an Azure AD (Entra ID) app
# registration with admin-consented permissions exists. Never commit real values.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
